DATABASE_URL='postgresql://postgres:postgres@localhost:5433/wealth-db'
DATABASE_PASSWORD='postgres'
DATABASE_NAME='wealth-db'
REDIS_URL='redis://localhost:6379'
PORT=4000

# Envs for Better Stack
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=
BETTER_STACK_ERRORS_DSN=

# Comma-separated browser origins allowed to call the API (oRPC + REST).
# Required in production. In non-production, omit to reflect the request Origin.
CORS_ORIGIN=http://localhost:3000

# Envs for local Minio storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
STORAGE_BUCKET=wealth-storage
STORAGE_PUBLIC_URL=http://localhost:9000/wealth-storage